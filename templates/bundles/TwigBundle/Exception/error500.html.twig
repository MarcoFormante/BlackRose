{% extends 'base.html.twig' %}

{% block title %}| Errore del server{% endblock %}

{% block meta %}
    <meta name="robots" content="noindex, nofollow">
{% endblock %}

{% block body %}
<div class="error-page">
    <p class="error-page__code">5<span>0</span>0</p>
    <h1 class="error-page__title">Errore del server</h1>
    <p class="error-page__text">
        Si è verificato un problema imprevisto sul nostro server.
        Stiamo già lavorando per risolverlo, riprova tra qualche minuto.
    </p>
    <a href="{{ path('app_home') }}" class="error-page__btn">Torna alla home</a>
</div>
{% endblock %}
