<section
    class="gallery section-margin-top"
    id="galleria"
    data-controller="swiper"
>
    <div class="default_padding_x">
        <twig:sectionheading
            title="GALLERIA"
            subTitle="Guarda i nostri lavori"
        />
    </div>
    <div
        class="swiper-mix slider-top slider-margin-top slider"
        data-swiper-target="slider"
    >
        <twig:SliderButtons/>
        <div class="swiper-wrapper">
            {% set halfLength = ((mixAlbum|length )  / 2)|round(0,'ceil') %}
            {% for image in mixAlbum|slice(0, halfLength ) %}
                <div class="swiper-slide" data-index="{{loop.index0}}">
                   <img
                       loading="lazy"
                       src="/assets/uploads/mixAlbum/{{image}}"
                       alt
                   />
                </div>
            {% endfor %}
           
        </div>          
    </div>

    {# SECOND SLIDER #}
    <div class="swiper-mix slider-bottom" data-swiper-target="secondSlider">
        <div class="swiper-wrapper">
            {% for image in mixAlbum|slice(halfLength) %}
                <div class="swiper-slide" data-index="{{loop.index0 + halfLength}}">
                   <img
                       loading="lazy"
                       src="/assets//uploads/mixAlbum/{{image}}"
                       alt
                   />
                </div>
            {% endfor %}
              {% if mixAlbum|length is not divisible by(2) %}
             <div class="swiper-slide"></div>
            {% endif %}
            
        </div>
    </div>
</section>
