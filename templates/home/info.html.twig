<section class="info section-margin-top" id="info" data-controller="swiper">
    <div class="default_padding_x">
        <twig:sectionheading title="INFO E CONTATTI" subTitle="Contattaci" />
    </div>

    <div class="info-container default_padding_left" data-controller="form">
        <div>
            <h3>PRENOTA UN APPUNTAMENTO</h3>
            <P class="grey-text form-desc">
                Inserisci le info per l'appuntamento, ti è possibile allegare
                anche immagini e lasciare un messaggio. Ti ricontatteremo il
                prima possibile
            </P>
            {{ form_start(form) }}
            <div
                class="form-input-container-relative form-input-container-small-input"
            >
                {{ form_label(form.name) }}
                {{ form_widget(form.name) }}
            </div>
            <div
                class="form-input-container-relative form-input-container-small-input"
            >
                {{ form_label(form.day) }}
                {{ form_widget(form.day,{'attr':{'data-form-target':'datePicker'}}) }}
            </div>
            <div
                class="form-input-container-relative form-input-container-small-input"
            >
                {{ form_label(form.email) }}
                {{ form_widget(form.email) }}
            </div>

            <div
                class="form-input-container-relative form-input-container-small-input"
            >
                {{ form_label(form.time) }}
                {{ form_widget(form.time,{'attr':{'data-form-target':'timePicker'}}) }}
            </div>
            <div
                class="form-input-container-relative form-input-container-big-input"
            >
                {{ form_label(form.message) }}
                {{ form_widget(form.message) }}
            </div>
            <div
                class="form-input-container-relative form-input-container-small-input overflow-hidden file-container"
            >
                <div class="file-image">
                    <img
                        aria-hidden="true"
                        src="{{ asset('images/upload-image_icon.svg') }}"
                        width="30"
                        height="40"
                        alt=""
                        data-form-target="fileImage"
                    />
                </div>
                
                {{ form_label(form.file) }}
                {{ form_widget(form.file,{'attr':{'data-form-target':'fileInput'}})}}
            </div>

            <div
                class="form-input-container-relative form-input-container-small-input overflow-hidden bgColor_transparent"
            >
                {{ form_label(form.submit) }}
                {{ form_widget(form.submit) }}
            </div>

            {{ form_end(form) }}
        </div>

<div class="address-info">
    <h3>INFORMAZIONI UTILI</h3>
    <address itemscope itemtype="https://schema.org/TattooParlor" itemref="info-studio">
        <ul>
            <li class="location-icon">
                <div>
                    <span itemprop="name">Black Rose Tattoo Studio</span> - <br />
                    <span
                        itemprop="address"
                        itemscope
                        itemtype="https://schema.org/PostalAddress"
                    >
                        <span itemprop="streetAddress">Via Regina Margherita 5</span>,
                        <span itemprop="addressLocality">Messina</span>
                        (<span itemprop="addressRegion">ME</span>)
                    </span>
                </div>
            </li>
            <li class="tel-icon">
                <a
                    href="tel:+393392191992"
                    class="text-info-item"
                    title="Chiama il numero di telefono Black Rose Tattoo"
                    itemprop="telephone"
                >
                    3392191992
                </a>
            </li>
            <li class="email-icon">
                <a
                    href="mailto:blackroseta2studio@gmail.com"
                    class="text-info-item text-info-item-link item-email-link"
                    title="Invia un'email a Black Rose Tattoo Studio"
                    itemprop="email"
                >
                    blackroseta2studio@gmail.com
                </a>
            </li>
            <li class="wa-icon">
                <a
                    href="https://wa.me/393392191992"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-info-item text-info-item-link item-whatsapp-link"
                    title="Contattaci su WhatsApp"
                >
                    Contatta su WhatsApp
                </a>
            </li>
            <li class="insta-icon">
                <a
                    href="https://www.instagram.com/blackrose.tattoostudio/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-info-item text-info-item-link item-instagram-link"
                    title="Visita la nostra pagina Instagram"
                    itemprop="sameAs"
                >
                    @BlackRoseTattoo
                </a>
            </li>
        </ul>
    </address>
</div>

<div id="info-studio">
    <h3>ORARI D'APERTURA</h3>
    <div class="flex-container">
        <div class="info-container-item info-item-container">
            <div aria-hidden="true" class="time-icon"></div>
            <p class="text-info-item text-info-item-openTime">
                <span itemprop="openingHours" content="Mo-Fr 10:00-17:30">
                    <b>LUN-VEN:</b> <time datetime="10:00">10:00</time>-<time datetime="17:30">17:30</time>
                </span><br />
                <span itemprop="openingHours" content="Sa 10:00-17:30">
                    <b>SAB:</b> <time datetime="10:00">10:00</time>-<time datetime="17:30">17:30</time>
                </span><br />
                <span><b>DOM:</b> Chiuso</span>
            </p>
        </div>
        <div>
            <h3>DOVE TROVARCI</h3>
            <div class="map">
                <iframe title="Trovaci su Google Maps" class="map" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3135.4552668554447!2d15.541866392980303!3d38.19932569938028!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x13144d71d2a7dff7%3A0x73f8435d376fc20f!2sBlack%20rose%20tattoo%20studio!5e0!3m2!1sen!2sfr!4v1701504103333!5m2!1sen!2sfr" width="600" height="450" allowfullscreen="true" loading="lazy" referrerpolicy="no-referrer-when-downgrade" style="border: 0px; width: 100%; z-index: 10; position: relative;"></iframe>
            </div>
        </div>
    </div>
</div>
</section>
