<section class="info section-margin-top" id="info" data-controller="swiper">
    <div class="default_padding_x">
        <twig:sectionheading title="INFO E CONTATTI" subTitle="Contattaci" />
    </div>
   <turbo-frame id="message_form_frame">
    <div class="info-container default_padding_left" data-controller="form">
        <div>
            <h3 class="lato-black">PRENOTA UN APPUNTAMENTO</h3>
            <P class="grey-text form-desc lato-regular">
                Inserisci le info per l'appuntamento, ti è possibile allegare
                anche immagini e lasciare un messaggio. Ti ricontatteremo il
                prima possibile
            </P>
              
                {{ form_start(form,{'attr':{'data-form-target':'form'}}) }}
                    {% if success is defined %}
                        <div class="alert alert-success">
                            <p>{{success}}</p>
                        </div>
                    {% endif %}
                    <div
                        class="form-input-container-relative form-input-container-small-input lato-regular form-order-mobile-1"
                    >
                        {{ form_label(form.name) }}
                        {{ form_widget(form.name) }}
                    </div>
                    <div
                        class="form-input-container-relative form-input-container-small-input form-order-mobile-3"
                    >
                        {{ form_label(form.day) }}
                        {{ form_widget(form.day,{'attr':{'data-form-target':'datePicker'}}) }}
                    </div>
                    <div
                        class="form-input-container-relative form-input-container-small-input form-order-mobile-2"
                    >
                        {{ form_label(form.email) }}
                        {{ form_widget(form.email) }}
                    </div>

                    <div
                        class="form-input-container-relative form-input-container-small-input form-order-mobile-4"
                    >
                        {{ form_label(form.time) }}
                        {{ form_widget(form.time,{'attr':{'data-form-target':'timePicker'}}) }}
                    </div>
                    <div
                        class="form-input-container-relative form-input-container-big-input form-order-mobile-5"
                    >
                        {{ form_label(form.message) }}
                        {{ form_widget(form.message) }}
                    </div>
                    <div
                        class="form-input-container-relative form-input-container-small-input overflow-hidden file-container form-order-mobile-6"
                    >
                        <div class="file-image">
                            <img
                                aria-hidden="true"
                                src="{{ asset('images/upload-image_icon.svg') }}"
                                width="30"
                                height="40"
                                alt=""
                                data-form-target="fileImage"
                                loading="lazy"
                            />
                        </div>
                        
                        {{ form_label(form.file) }}
                        {{ form_widget(form.file,{'attr':{'data-form-target':'fileInput'}})}}
                    </div>

                    <div
                        class="form-input-container-relative form-input-container-small-input overflow-hidden bgColor_transparent form-order-mobile-7"
                    >
                        {{ form_label(form.submit) }}
                        {{ form_widget(form.submit) }}
                    </div>
                    {% if errors is defined and errors|length %}
                        <div class="alert alert-error">
                             <div class="form-errors lato-regular">
                                {% for error in errors %}
                                    <p>{{error}}</p>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                    
                {{ form_end(form) }}
            
        </div>
        </turbo-frame>

