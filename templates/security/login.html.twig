{% extends 'base.html.twig' %}

{% block title %}Login{% endblock %}


{% block body %}
<style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
          background: #000;
            background-size: cover;
            font-family: 'Inter', sans-serif;
            color: #fff;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            overflow: hidden;
        }


        /* Dark overlay for readability */
        body::before {
            content: '';
            position: absolute;
            inset: 0;
            background: rgba(5, 5, 10, 0.65);
            backdrop-filter: blur(3px);
            z-index: 0;
        }

        
        #loginForm{
            display: flex;
            flex-direction: column;
        }


        /* Login card */
        .login-box {
            position: relative;
            z-index: 2;
            background: rgba(17, 17, 26, 0.88);
            padding: 10px 40px;
            border-radius: 24px;
            width: 100%;
            max-width: 420px;
            text-align: center;
            border: 1px solid rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(24px);
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(0, 212, 255, 0.05);
            animation: cardIn 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
        }

        @keyframes cardIn {
            from { opacity: 0; transform: translateY(30px) scale(0.95); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }


        h1 {
            margin-bottom: 28px;
            font-weight: 300;
            font-size: 1.15rem;
            color: #aaa;
        }

        .input-group {
            position: relative;
            margin-bottom: 18px;
            text-align: left;
            transition: transform 0.3s;
        }

        .input-group label {
            display: block;
            font-size: 0.75rem;
            font-weight: 600;
            color: #8890a8;
            margin-bottom: 6px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        input {
            width: 100%;
            padding: 13px 16px;
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            background: rgba(0, 0, 0, 0.35);
            color: white;
            font-size: 1rem;
            font-family: inherit;
            outline: none;
            transition: all 0.3s;
        }

        input::placeholder {
            color: #555;
        }

        input:focus {
            border-color: rgba(0, 212, 255, 0.5);
            box-shadow: 0 0 0 3px rgba(0, 212, 255, 0.1), 0 0 20px rgba(0, 212, 255, 0.1);
            background: rgba(0, 0, 0, 0.5);
        }

        .password-wrap {
            position: relative;
        }

        .toggle-password {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: #666;
            cursor: pointer;
            font-size: 0.9rem;
            padding: 4px;
            transition: color 0.2s;
        }

        .toggle-password:hover {
            color: #00d4ff;
        }

        .options-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 8px 0 24px;
            font-size: 0.85rem;
        }

        .remember {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #aaa;
            cursor: pointer;
        }

        .remember input {
            width: auto;
            appearance: none;
            width: 16px;
            height: 16px;
            border: 1px solid rgba(255,255,255,0.2);
            border-radius: 4px;
            background: rgba(0,0,0,0.3);
            cursor: pointer;
            position: relative;
            transition: 0.2s;
        }

        .remember input:checked {
            background: #00d4ff;
            border-color: #00d4ff;
        }

        .remember input:checked::after {
            content: '✓';
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #000;
            font-size: 0.7rem;
            font-weight: 700;
        }

        .forgot {
            color: #00d4ff;
            text-decoration: none;
            font-size: 0.85rem;
            transition: opacity 0.2s;
        }

        .forgot:hover {
            opacity: 0.8;
            text-decoration: underline;
        }

        .btn-login {
            display: block;
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, #1b089794, #000000);
            color: #fff;
            border: none;
            border-radius: 12px;
            text-decoration: none;
            font-weight: 700;
            font-size: 1rem;
            font-family: inherit;
            margin-top: 8px;
            cursor: pointer;
            position: relative;
            overflow: hidden;
            transition: all 0.3s;
            box-shadow: 0 4px 20px rgba(0, 212, 255, 0.25);
            margin-top: 40px;
        }

        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 30px rgba(0, 212, 255, 0.4);
        }

        .btn-login:active {
            transform: translateY(0);
        }

        .btn-login.loading {
            pointer-events: none;
            opacity: 0.8;
        }

        .btn-login.loading::after {
            content: '';
            position: absolute;
            width: 20px;
            height: 20px;
            border: 2px solid rgba(255,255,255,0.3);
            border-top-color: #fff;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
            top: 50%;
            left: 50%;
            margin-top: -10px;
            margin-left: -10px;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        .divider {
            display: flex;
            align-items: center;
            gap: 16px;
            margin: 28px 0;
            color: #666;
            font-size: 0.8rem;
        }

        .divider::before,
        .divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: rgba(255,255,255,0.1);
        }

        .social-text {
            font-size: 0.85rem;
            color: #888;
            margin-bottom: 14px;
        }

        .social-login {
            display: flex;
            justify-content: center;
            gap: 12px;
        }

        .social-btn {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 12px;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 12px;
            color: #fff;
            font-size: 0.85rem;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.3s;
            font-family: inherit;
        }

        .social-btn:hover {
            background: rgba(255, 255, 255, 0.08);
            transform: translateY(-2px);
        }

        .social-btn i {
            font-size: 1.1rem;
        }

        .social-btn.discord:hover {
            border-color: #5865F2;
            color: #5865F2;
        }

        .social-btn.telegram:hover {
            border-color: #26A5E4;
            color: #26A5E4;
        }

        .social-btn.google:hover {
            border-color: #EA4335;
            color: #EA4335;
        }

        .register-link {
            margin-top: 24px;
            font-size: 0.9rem;
            color: #888;
        }

        .register-link a {
            color: #00d4ff;
            text-decoration: none;
            font-weight: 600;
        }

        .register-link a:hover {
            text-decoration: underline;
        }

        .error-msg {
            color: #ff4444;
            font-size: 0.85rem;
            margin-top: 6px;
            display: none;
        }

        .error-msg.show {
            display: block;
            animation: fadeIn 0.3s;
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

       
    </style>
    <div>
        {% if error %}
                <div class="alert alert-error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

        {% if app.user %}
            <div class="alert alert-success">
                You are logged in as {{ app.user.userIdentifier }}, <a href="{{ logout_path() }}">Logout</a>
            </div>
        {% endif %}

     
    </div>
       
        <div class="login-box" id="loginBox">
      
        <h1>Black Rose Tattoo Member Login</h1>
        
        <form id="loginForm" method="post" action="{{ path('app_login') }}">
            <div class="input-group">
               <label for="username" class="lato-regular">Username</label>
                <input type="text" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="username" required autofocus>
            </div>

            <div class="input-group">
                <label for="password" class="lato-regular">Password</label>
                <div class="password-wrap">
                  <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required>
                    <button type="button" class="toggle-password" id="togglePass" aria-label="Показать пароль">
                        <i class="fas fa-eye" id="eyeIcon"></i>
                    </button>
                </div>
            </div>
              <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit" class="btn-login" id="submitBtn">Sign in</button>
        </form>
        </div>
{% endblock %}




